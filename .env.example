# Firecrawl API key — get one at https://www.firecrawl.dev/app/api-keys
# Without this, the app runs on mock data only.
FIRECRAWL_API_KEY=fc-your-key-here

# Optional: port to run the server on (defaults to 3000)
# PORT=3000

# ---------------------------------------------------------------------------
# HTTP basic auth. REQUIRED if you deploy this anywhere public — without it
# every endpoint is open (your ntfy topic, your watchlist, the test-notify
# endpoint). Leave blank for local development and auth is skipped.
# ---------------------------------------------------------------------------
APP_USER=
APP_PASS=

# Timezone. Release dates are compared at local midnight, so a UTC container
# can shift the day boundary. Set this when deploying.
# TZ=Europe/Dublin

# ---------------------------------------------------------------------------
# Notifications — credentials only. Recipients + on/off toggles are set in the
# app's "Notifications" panel (stored in data/settings.json).
# Each channel activates only when its credentials are present here AND it is
# enabled with a recipient in the UI.
# ---------------------------------------------------------------------------

# --- Email (SMTP) ---
# Gmail: use an App Password (https://myaccount.google.com/apppasswords),
# NOT your normal password. Requires 2FA on the account.
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_SECURE=false        # true for port 465
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Optional; defaults to SMTP_USER
SMTP_FROM=

# --- Phone push (ntfy.sh) ---
# No credentials needed. Install the ntfy app, subscribe to a SECRET topic name,
# then set that same topic in the app's Notifications panel.
# Anyone who knows the topic can read it — pick something unguessable.
# Optional: self-hosted server (defaults to https://ntfy.sh)
# NTFY_SERVER=https://ntfy.sh

# --- SMS (Twilio) ---
# Costs per message. Leave blank to disable SMS entirely.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
